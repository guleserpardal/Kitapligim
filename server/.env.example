# Bu dosyayı .env olarak kopyala ve APP_TOKEN değerini uzun, rastgele bir metinle değiştir.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_TOKEN=
PORT=8790
HOST=0.0.0.0
# Claude Code CLI komutu (Windows'ta claude.exe tam yolu da verilebilir).
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MS=120000
# Önerileri Türkçe katalog, Google Books, Trendyol ve Open Library ile doğrula (1 = açık).
ENRICH=1
